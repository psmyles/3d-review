### The axis gizmo in the corner of the 3D viewport. Clicking an axis snaps the
### camera to look down it.

ui-gizmo-reset-view = Reset view
    .description = Puts the camera back where it was when the model first opened. The R
        key does the same thing.
ui-gizmo-view-axis = View { $axis }
    .description = Turns the camera to look straight down this axis.

# The axis each ball looks down, as its tooltip names it ("View +X"). The
# negative balls are painted with these too.
ui-gizmo-axis-neg-x = -X
ui-gizmo-axis-neg-y = -Y
ui-gizmo-axis-neg-z = -Z
ui-gizmo-axis-pos-x = +X
ui-gizmo-axis-pos-y = +Y
ui-gizmo-axis-pos-z = +Z

# The positive balls' painted labels: the bare letter, without the sign the
# tooltip uses to tell the two directions apart.
ui-gizmo-ball-x = X
ui-gizmo-ball-y = Y
ui-gizmo-ball-z = Z
