### The macOS menu bar. A Mac app without one cannot even be quit, so this is the
### one piece of chrome that is not drawn by egui. It carries the same entries as
### the toolbar's menu (`ui-toolbar-menu-*`), placed where a Mac puts them.

menu-file = File
menu-debug = Debug
menu-window = Window
menu-help = Help
menu-new = New
menu-open = Open...
menu-add-animations = Add Animations...
menu-open-recent = Open Recent
menu-clear-recent-files = Clear Recent Files
menu-close-window = Close Window
menu-about = About { $product }
menu-remember-settings = Remember Settings
# Links the bundled review-cli onto the PATH. macOS only, since Setup does it on
# Windows and the .dmg has no installer to.
menu-install-command-line-tool = Install Command Line Tool...
menu-hide = Hide { $product }
menu-hide-others = Hide Others
menu-show-all = Show All
menu-quit = Quit { $product }
menu-services = Services
menu-view-log = View Log
menu-tracy-profiler = Tracy Profiler
menu-minimize = Minimize
menu-zoom = Zoom
menu-documentation = Documentation
menu-check-for-updates = Check for Updates
menu-report-issue = Report an Issue
menu-credits = Credits
