### The macOS menu bar. A Mac app without one cannot even be quit, so this is the
### one piece of chrome that is not drawn by egui.

menu-file = File
menu-window = Window
menu-new = New
menu-open = Open...
menu-about = About { $product }
menu-hide = Hide { $product }
menu-hide-others = Hide Others
menu-show-all = Show All
menu-quit = Quit { $product }
menu-services = Services
menu-minimize = Minimize
menu-zoom = Zoom
