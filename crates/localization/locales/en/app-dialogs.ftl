### Native file-dialog titles and filter names.
###
### These reach the OS dialog rather than our own chrome, but they are still text
### the user reads, so they live in the catalog like everything else.

app-dialogs-open-model = Open Model
app-dialogs-import-textures = Import Textures
app-dialogs-export-mesh = Export optimized mesh
app-dialogs-save-preset = Save optimization preset
app-dialogs-load-preset = Load optimization preset

# Filter names in the dialog's file-type dropdown.
app-dialogs-filter-fbx = FBX
app-dialogs-filter-image = Image
app-dialogs-filter-preset = Optimization preset

# Default file name offered when saving a preset.
app-dialogs-preset-file-name = optimization-preset.json
# The export dialog's default file name when the model has no name of its own.
app-dialogs-export-file-name = optimized
