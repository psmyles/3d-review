### The Log window (Debug > View Log): everything the viewer has reported this
### session. The lines themselves are diagnostics and stay in English, like an
### error's detail; only the window around them is translated.

ui-log-title = Log

# The row of switches along the top, one per level.
ui-log-filter = Filter
ui-log-level-debug = Debug
ui-log-level-info = Info
ui-log-level-warning = Warning
ui-log-level-error = Error

ui-log-clear = Clear

# The level column of each line. Short and in capitals, like the log file's own,
# so the column stays narrow.
ui-log-row-debug = DEBUG
ui-log-row-info = INFO
ui-log-row-warning = WARN
ui-log-row-error = ERROR

# Shown in place of the lines while the filter leaves none to show.
ui-log-empty = Nothing to show.

# Under the lines: where the whole day's log is kept.
ui-log-file = Saved to { $path }
