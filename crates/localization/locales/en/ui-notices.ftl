### The notification cards' own chrome. A card is a header saying what *kind* of
### thing it is, then the message; these are the headers.

ui-notices-working = Working
ui-notices-info = Info
ui-notices-success = Success
ui-notices-warning = Warning
ui-notices-error = Error
ui-notices-dismiss = Dismiss
# Shown when a report's body is longer than the card can hold.
ui-notices-more = + { $hidden } more
