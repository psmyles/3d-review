### The Aud workspace's notices: profile and report IO, and the audit's own
### failures.

app-audit-auditing = Checking the model...
app-audit-summary-copied = Summary copied
app-audit-profile-saved = Saved the audit profile to { $file }
app-audit-profile-loaded = Loaded the audit profile { $file }
app-audit-report-saved = Saved the audit report to { $file }
app-audit-profile-unreadable = Couldn't read the audit profile: { $reason }
app-audit-profile-newer = This audit profile was saved by a newer version of 3D Review
    (profile version { $found }; this version reads up to { $supported }). Open it with the
    version that saved it.
app-audit-saved-profile-reset = The saved audit profile couldn't be read, so the Generic
    profile is in use: { $reason }
app-audit-report-failed = Couldn't build the audit report: { $reason }
app-audit-failed = The model couldn't be checked: { $reason }
