+
+/* review: `EIGEN_MPL2_ONLY` selects `SparseLU` in place of `SimplicialLLT`
+   above, and `SparseLU` reports a failed factorization through `info()` while
+   leaving its internal supernodal matrix unallocated. Nothing below checks, and
+   `solve()` on that state reads through a null pointer — a segfault rather than
+   a bad answer, seen on a real game asset whose scale system is singular.
+
+   Throwing turns it into something a caller can act on: this project's bridge
+   catches it and falls back to the field-based extraction, which has no
+   comparable failure mode. */
+template <class Solver>
+static void review_require_factorized(const Solver &solver, const char *stage) {
+    if (solver.info() != Eigen::Success) {
+        throw std::runtime_error(std::string("quadriflow: the ") + stage +
+                                 " system could not be factorized");
+    }
+}
 
 Optimizer::Optimizer() {}
 
