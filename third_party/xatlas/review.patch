+// review patch P1: the transcendental functions xatlas calls (the LSCM setup's
+// angles, the chart rotation in packing) come from the platform's maths
+// library, which is free to round the last bit differently on every OS. These
+// are 3D Review's (`crates/optimize/src/xatlas/ffi.rs`: the pure-Rust libm), the
+// same bits everywhere (docs/ARCHITECTURE.md, D27). Defined after every
+// include, so no library declaration is renamed.
+extern "C" float review_xatlas_acosf(float x);
+extern "C" float review_xatlas_sinf(float x);
+extern "C" float review_xatlas_cosf(float x);
+extern "C" float review_xatlas_atan2f(float y, float x);
+#define acosf review_xatlas_acosf
+#define sinf review_xatlas_sinf
+#define cosf review_xatlas_cosf
+#define atan2f review_xatlas_atan2f
+// end review patch P1
+
+// review patch P2: xatlas keeps an orthogonal projection of a curved chart
+// that stretches up to 10% on average (25% at its worst triangle), which is
+// fine for a lightmap and not for a tiling surface texture: a strip of a
+// cylinder came out stretched where LSCM unrolls it exactly. 3D Review keeps a
+// projection only when it is all but exact, and flattens the rest by LSCM.
+#define REVIEW_XATLAS_ORTHO_STRETCH 1.001f
+#define REVIEW_XATLAS_ORTHO_MAX_STRETCH 1.01f
+// end review patch P2
+
