+		ufbxwi_failf(&scene->error, UFBXW_ERROR_WRONG_DATA_TYPE, "Texture is not a layered texture");
+		return;
+	}
+
+	int32_t *mode = ufbxwi_list_push_copy(&scene->ator, &td->blend_modes, int32_t, &blend_mode);
+	ufbxwi_check(mode);
+	ufbxw_real *a = ufbxwi_list_push_copy(&scene->ator, &td->alphas, ufbxw_real, &alpha);
+	ufbxwi_check(a);
+
+	// The layer order is the connection order; the generic connection is the only one a texture -> texture pair matches.
+	ufbxwi_connect(scene, UFBXW_CONNECTION_CUSTOM, layer.id, layered.id, 0);
+}
