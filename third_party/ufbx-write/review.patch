+ufbxw_abi void ufbxw_lod_group_add_level(ufbxw_scene *scene, ufbxw_lod_group group, ufbxw_real distance, int32_t display)
+{
+	ufbxwi_element *element = ufbxwi_get_element(scene, group.id);
+	ufbxwi_check_element(scene, group.id, element);
+
+	// The level count is the number of `DisplayLevels|Level<n>` properties already present.
+	char name[64];
+	size_t level = 0;
+	for (;;) {
+		int len = snprintf(name, sizeof(name), "DisplayLevels|Level%zu", level);
+		ufbxwi_token token = ufbxwi_get_token(&scene->string_pool, name, (size_t)len);
+		if (!token || !ufbxwi_props_find_prop(&element->props, token)) break;
+		level++;
+	}
+
+	if (level > 0) {
+		// Level `n` starts at `Thresholds|Level<n-1>`; the first level has no threshold.
+		snprintf(name, sizeof(name), "Thresholds|Level%zu", level - 1);
+		ufbxw_add_real_string(scene, group.id, name, UFBXW_PROP_TYPE_DISTANCE, distance, "cm");
+	}
+	snprintf(name, sizeof(name), "DisplayLevels|Level%zu", level);
+	ufbxw_add_int(scene, group.id, name, UFBXW_PROP_TYPE_ENUM, display);
+}
