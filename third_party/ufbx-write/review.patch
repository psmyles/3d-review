+// review patch P1
+ufbxw_abi void ufbxw_add_real_string(ufbxw_scene *scene, ufbxw_id id, const char *prop, ufbxw_prop_type type, ufbxw_real value, const char *str)
+{
+	ufbxw_real_string rs;
+	rs.value = value;
+	if (!ufbxwi_intern_string(&scene->string_pool, &rs.string, str, strlen(str))) return;
+	ufbxwi_add_prop(scene, id, prop, strlen(prop), type, &rs, UFBXW_PROP_DATA_REAL_STRING);
+}
+
+ufbxw_abi void ufbxw_add_blob(ufbxw_scene *scene, ufbxw_id id, const char *prop, ufbxw_prop_type type, const void *data, size_t size)
+{
+	ufbxw_blob blob;
+	blob.size = size;
+	if (size > 0) {
+		void *copy = ufbxwi_alloc_size(&scene->ator, 1, size, NULL);
+		if (!copy) return;
+		memcpy(copy, data, size);
+		blob.data = copy;
+	} else {
+		blob.data = ufbxwi_empty_char;
+	}
+	ufbxwi_add_prop(scene, id, prop, strlen(prop), type, &blob, UFBXW_PROP_DATA_BLOB);
+}
+
+ufbxw_abi void ufbxw_set_prop_flags(ufbxw_scene *scene, ufbxw_id id, const char *prop, uint32_t flags)
+{
+	ufbxwi_token token = ufbxwi_get_token(&scene->string_pool, prop, strlen(prop));
+	ufbxwi_element *element = ufbxwi_get_element(scene, id);
+	if (!token || !element) return;
+
+	ufbxwi_prop *p = ufbxwi_element_edit_prop(scene, element, token);
+	if (!p) {
+		ufbxwi_failf(&scene->error, UFBXW_ERROR_PROP_NOT_FOUND, "Property not found: %s", prop);
+		return;
+	}
+
+	uint32_t mask = UFBXW_PROP_FLAG_ANIMATABLE | UFBXW_PROP_FLAG_USER | UFBXW_PROP_FLAG_HIDDEN | UFBXW_PROP_FLAG_EXPLICIT;
+	p->flags = (p->flags & ~mask) | (flags & mask);
+}
+
+ufbxw_abi uint32_t ufbxw_get_prop_flags(ufbxw_scene *scene, ufbxw_id id, const char *prop)
+{
+	ufbxwi_token token = ufbxwi_get_token(&scene->string_pool, prop, strlen(prop));
+	ufbxwi_element *element = ufbxwi_get_element(scene, id);
+	if (!token || !element) return 0;
+
+	ufbxwi_prop *p = ufbxwi_element_find_prop(scene, element, token);
