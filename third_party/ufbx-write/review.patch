+ufbxw_abi void ufbxw_texture_add_layer(ufbxw_scene *scene, ufbxw_texture layered, ufbxw_texture layer, int32_t blend_mode, ufbxw_real alpha)
+{
+	ufbxwi_texture *td = ufbxwi_get_texture(scene, layered);
+	ufbxwi_check_element(scene, layered.id, td);
+	ufbxwi_check_element(scene, layer.id, ufbxwi_get_texture(scene, layer));
